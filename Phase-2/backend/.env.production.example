# Production Environment Variables for Backend

# Database Configuration (required)
# Use your production PostgreSQL connection string
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@production-host:5432/todo_prod

# JWT Configuration (required)
# CRITICAL: Generate a secure random key for production
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-KEY-IN-PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Configuration (required)
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Application Configuration (optional)
# APP_ENV=production
# LOG_LEVEL=INFO
# DEBUG=False

# Rate Limiting (optional)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=60

# Email Configuration (optional, for future features)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=noreply@yourdomain.com

# Monitoring (optional)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
